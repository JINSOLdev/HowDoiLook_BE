{
    "compilerOptions": {
        "allowJs": true,
        "target": "es2022",
        "lib": ["ES2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
    },
    "include": ["./src/**/*", "./src/**/*.ts", "./src/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}